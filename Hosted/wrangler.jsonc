{
  "name": "apple-core-hosted",
  "main": "worker.mjs",
  "account_id": "059585806715245840e5581f7174246d",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mcp.applecore.app", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "MACS", "class_name": "MacRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MacRelay"] }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "limits": { "cpu_ms": 50 },
  "vars": { "HOSTED_PAUSED": "false", "HOSTED_DAILY_LIMIT": "2000", "HOSTED_MONTHLY_LIMIT": "20000" },
  "observability": { "enabled": false }
}
