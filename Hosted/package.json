{
  "name": "apple-core-hosted",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm run build && npm run build:verification-test",
    "test": "node --test protocol.test.mjs integration.test.mjs store-verification.test.mjs",
    "build": "wrangler deploy --dry-run --outdir build",
    "types": "wrangler types",
    "build:verification-test": "wrangler deploy --dry-run --config tests/wrangler.verification.jsonc --outdir build-verification"
  },
  "devDependencies": {
    "miniflare": "5.20260907.0-alpha",
    "wrangler": "4.129.1"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0"
  }
}
